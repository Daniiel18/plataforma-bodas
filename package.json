{
  "name": "plataforma-bodas",
  "version": "1.1.0",
  "private": true,
  "description": "Customizable wedding invitation platform with a private dashboard for the couple: RSVP with wishes, 3D photo gallery, music, countdown, add-to-calendar, gift box with QR and push notifications.",
  "license": "UNLICENSED",
  "author": "Daniel Espinal (https://github.com/Daniiel18)",
  "homepage": "https://github.com/Daniiel18/plataforma-bodas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daniiel18/plataforma-bodas.git"
  },
  "bugs": {
    "url": "https://github.com/Daniiel18/plataforma-bodas/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run format:check",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:backup": "node --env-file=.env.local scripts/db-backup.mjs",
    "wedding:create": "node --env-file=.env.local scripts/create-wedding.mjs",
    "admin:link": "node --env-file=.env.local scripts/link-admin.mjs",
    "demo:seed": "node --env-file=.env.local scripts/seed-demo.mjs",
    "demo:data": "node --env-file=.env.local scripts/demo-data.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "exceljs": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "swiper": "^14.3.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qrcode": "^1.5.4",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
