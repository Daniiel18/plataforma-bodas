# Copy this file to .env.local and fill in the values. .env.local is never committed.
# See docs/deployment.md for where to find each value.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only, never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Web Push (couple's notifications). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-domain.example

# Random secrets (any long random string).
IP_HASH_SALT=
CRON_SECRET=

# Optional: raises the free MyMemory translation quota.
MYMEMORY_EMAIL=

# Local scripts only (migrations, demo seeding): Supabase → Connect → Session pooler.
DATABASE_URL=
